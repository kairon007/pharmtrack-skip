# PharmTrack configuration
# Copy this file to .env and fill in your own values. Never commit .env.
#
# This file is a template: every credential below is a placeholder.

# App Name
APP_NAME=PharmTrack

# Android Configuration
# Package name for your Android app (reverse domain notation)
ANDROID_PACKAGE_NAME=com.tunnxo.medtrack

# iOS Configuration
# Bundle ID for your iOS app (must match Apple Developer Portal)
APPLE_BUNDLE_ID=com.tunnxo.medtrack

# Optional: App Store Connect App ID (numeric)
# Find this in App Store Connect > App Information
APPLE_APP_ID=1234567890

# Optional: Apple Team ID (for signing)
# Find this in Apple Developer Portal (e.g. U82W9257A8)
# Required for build commands to automatically configure signing
APPLE_TEAM_ID=YOUR_TEAM_ID

# ============================================
# Machine-Wide Signing Directory
# ============================================

# Path to machine-wide signing directory
# All credentials are shared across apps on this machine
USER_SIGNING_DIR=${HOME}/.signing

# ============================================
# Google Play Credentials
# ============================================

# Google Play Service Account Key (machine-wide, shared by all apps)
# This is a JSON file downloaded from Google Play Console
# Path to the JSON key file
# Default path assumes standard signing directory structure
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=${USER_SIGNING_DIR}/google-play/service-account.json

# ============================================
# App Store Connect Credentials
# ============================================

# App Store Connect API Key (machine-wide, shared by all apps)
# Download from App Store Connect > Users and Access > Keys
# Required for uploading builds to TestFlight and App Store
APPSTORE_CONNECT_KEY_PATH=${USER_SIGNING_DIR}/ios/AuthKey_XXXXXXXXXX.p8
APPSTORE_CONNECT_KEY_ID=XXXXXXXXXX
APPSTORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000

# ============================================
# Android Signing (Machine-Wide)
# ============================================

# Android keystore is shared across all apps on this machine
# Keystore location: ${USER_SIGNING_DIR}/android/upload-keystore.jks
# Alias: upload (standard for all apps)
ANDROID_KEY_ALIAS=upload

# Android keystore passwords (machine-wide, shared by all apps)
# Get these from your password manager
ANDROID_KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
ANDROID_KEY_PASSWORD=YOUR_KEY_PASSWORD

# ============================================
# iOS Signing (Automatic)
# ============================================

# iOS uses automatic signing - no manual certificates or provisioning profiles needed
# Just configure your Apple Developer account in Xcode's Preferences > Accounts
# Xcode will automatically manage certificates and provisioning profiles
# We inject DEVELOPMENT_TEAM via Config.xcconfig -> User.xcconfig from .env

# ============================================
# Build Configuration
# ============================================

# Build Number Offset
# Add this offset to fetched build numbers (useful for CI/CD)
# Default: 0
BUILD_NUMBER_OFFSET=0

# ============================================
# Notes
# ============================================

# MACHINE-WIDE CREDENTIALS (shared by all apps):
# - Android keystore: ${USER_SIGNING_DIR}/android/upload-keystore.jks
# - Google Play service account: ${USER_SIGNING_DIR}/google-play/service-account.json
# - iOS API key: ${USER_SIGNING_DIR}/ios/AuthKey_*.p8
# - iOS team ID: in ${USER_SIGNING_DIR}/ios/AuthKey file
#
# NOTE: iOS certificates and provisioning profiles are NOT needed with automatic signing

# APP-SPECIFIC SETTINGS (in this .env):
# - Package name
# - Bundle ID
# - App Store Connect App ID
#
# NOTE: Provisioning profiles are auto-managed by Xcode with automatic signing

# ============================================
# Setup Checklist
# ============================================

# 1. Update machine-wide credentials in ${USER_SIGNING_DIR}/
#    See: signing/README.md

# 2. Update app-specific settings:
#    - APP_NAME
#    - ANDROID_PACKAGE_NAME
#    - APPLE_BUNDLE_ID
#    - APPLE_APP_ID

# 3. Verify paths:
#    ls -la ${USER_SIGNING_DIR}/android/upload-keystore.jks
#    ls -la ${USER_SIGNING_DIR}/google-play/service-account.json
#    ls -la ${USER_SIGNING_DIR}/ios/AuthKey_*.p8

# 4. Configure iOS automatic signing in Xcode:
#    - Open Project.xcworkspace
#    - Select the PharmTrack project > Signing & Capabilities
#    - Enable "Automatically manage signing"
#    - Select your team (or let User.xcconfig handle it with DEVELOPMENT_TEAM)

# 5. NEVER commit .env to version control
# 6. Add .env to your .gitignore
# 7. Use password manager for all passwords
